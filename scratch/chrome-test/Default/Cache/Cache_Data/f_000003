  box-shadow: 0 24px 60px rgba(192, 38, 211, 0.35);
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.products-cta-card::before {
  content: "";
  position: absolute;
  top: -80px;
  right: -80px;
  width: 240px;
  height: 240px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
