/* --------------------------------------------------------------------------
   5. CLOSING CTA BAND
   -------------------------------------------------------------------------- */
.products-cta-band {
  max-width: 1200px;
  margin: 40px auto 80px;
  padding: 0 20px;
  position: relative;
  z-index: 2;
}

.products-cta-card {
  background: var(--signature-gradient);
  border-radius: var(--radius-container);
  padding: 60px 44px;
  color: #FFFFFF;
