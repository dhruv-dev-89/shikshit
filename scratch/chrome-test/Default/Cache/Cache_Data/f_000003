.products-cta-card::after {
  content: "";
  position: absolute;
  bottom: -60px;
  left: -60px;
  width: 200px;
  height: 200px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  pointer-events: none;
}

.products-cta-card h3 {
  font-size: clamp(1.8rem, 3.4vw, 2.7rem);
