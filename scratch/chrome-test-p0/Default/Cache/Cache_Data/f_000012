  <!-- Mobile Menu Toggle Function -->
  <script>
    // Global function to toggle mobile menu - must be defined before HTML uses it
    function toggleMobileMenu(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }

      console.log("Toggle mobile menu function called");

      // Find the mobile menu and toggle button
      const mobileMenu = document.getElementById("mobileMenu");
      const toggleButton = document.querySelector(".mobile-menu-toggle");

      if (!mobileMenu) {
        console.error("Mobile menu not found");
        return;
      }

      // Toggle the active class on both menu and button
      const isActive = mobileMenu.classList.contains("active");

      if (isActive) {
        // Hide menu
        mobileMenu.classList.remove("active");
        if (toggleButton) toggleButton.classList.remove("active");
        console.log("Mobile menu hidden");
      } else {
        // Show menu
        mobileMenu.classList.add("active");
        if (toggleButton) toggleButton.classList.add("active");
        console.log("Mobile menu shown");
      }
    }

    // Make function globally available
    window.toggleMobileMenu = toggleMobileMenu;
  </script>

