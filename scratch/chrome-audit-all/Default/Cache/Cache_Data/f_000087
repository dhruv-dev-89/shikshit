    <!-- Simple Process Flow JavaScript -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Process Flow Step Interaction
            const processSteps = document.querySelectorAll('.process-flow-step');
            const processCards = document.querySelectorAll('.process-card-container');

            // Function to highlight a card when hovering over its corresponding step
            processSteps.forEach(step => {
                step.addEventListener('mouseenter', function() {
                    const stepNumber = parseInt(this.getAttribute('data-step'));

                    // Highlight the corresponding card and connector
                    processCards.forEach(card => {
                        const cardStep = parseInt(card.getAttribute('data-step'));
                        const cardElement = card.querySelector('.process-card');

                        if (cardStep === stepNumber) {
                            // Highlight the card
                            cardElement.style.transform = 'translateY(-5px)';
                            cardElement.style.boxShadow = '0 10px 20px rgba(0, 0, 0, 0.3)';

                            // Highlight the connector
                            const connector = this.querySelector('.vertical-connector');
                            const arrow = this.querySelector('.connector-arrow');
                            if (connector) {
                                connector.style.background = '#4fc3f7'; // Light blue highlight
                                connector.style.boxShadow = '0 0 15px rgba(79, 195, 247, 0.8)';
                                connector.style.width = '6px'; // Make it slightly thicker
                            }
                            if (arrow) {
                                arrow.style.borderTopColor = '#4fc3f7'; // Light blue highlight
                            }
                        }
                    });
                });

                step.addEventListener('mouseleave', function() {
                    // Reset all cards and connectors
                    processCards.forEach(card => {
                        const cardElement = card.querySelector('.process-card');
                        cardElement.style.transform = '';
                        cardElement.style.boxShadow = '';
                    });

                    // Reset connector styles
                    const connector = this.querySelector('.vertical-connector');
                    const arrow = this.querySelector('.connector-arrow');
                    if (connector) {
                        connector.style.background = '';
                        connector.style.boxShadow = '';
                        connector.style.width = '';
                    }
                    if (arrow) {
                        arrow.style.borderTopColor = '';
                    }
                });
            });

            // Add hover effect to cards
            processCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    const cardElement = this.querySelector('.process-card');
                    cardElement.style.transform = 'translateY(-5px)';
                    cardElement.style.boxShadow = '0 10px 20px rgba(0, 0, 0, 0.3)';

                    // Highlight the corresponding step and connector
                    const cardStep = parseInt(this.getAttribute('data-step'));
                    processSteps.forEach(step => {
                        const stepNumber = parseInt(step.getAttribute('data-step'));
                        if (stepNumber === cardStep) {
                            // Highlight the bubble
                            const bubble = step.querySelector('.process-step-bubble');
                            if (bubble) {
                                bubble.style.background = '#4fc3f7'; // Light blue highlight
                                bubble.style.boxShadow = '0 0 20px rgba(79, 195, 247, 0.8)';
                            }

                            // Highlight the connector
                            const connector = step.querySelector('.vertical-connector');
                            const arrow = step.querySelector('.connector-arrow');
                            if (connector) {
                                connector.style.background = '#4fc3f7'; // Light blue highlight
                                connector.style.boxShadow = '0 0 15px rgba(79, 195, 247, 0.8)';
                                connector.style.width = '6px'; // Make it slightly thicker
                            }
                            if (arrow) {
                                arrow.style.borderTopColor = '#4fc3f7'; // Light blue highlight
                            }
                        }
                    });
                });

                card.addEventListener('mouseleave', function() {
                    const cardElement = this.querySelector('.process-card');
                    cardElement.style.transform = '';
                    cardElement.style.boxShadow = '';

                    // Reset all steps and connectors
                    const cardStep = parseInt(this.getAttribute('data-step'));
                    processSteps.forEach(step => {
                        const stepNumber = parseInt(step.getAttribute('data-step'));
                        if (stepNumber === cardStep) {
                            // Reset bubble
                            const bubble = step.querySelector('.process-step-bubble');
                            if (bubble) {
                                bubble.style.background = '';
                                bubble.style.boxShadow = '';
                            }

                            // Reset connector
                            const connector = step.querySelector('.vertical-connector');
                            const arrow = step.querySelector('.connector-arrow');
                            if (connector) {
                                connector.style.background = '';
                                connector.style.boxShadow = '';
                                connector.style.width = '';
                            }
                            if (arrow) {
                                arrow.style.borderTopColor = '';
                            }
                        }
                    });
                });
            });
        });
