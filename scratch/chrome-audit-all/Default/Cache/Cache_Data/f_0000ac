  <script>
    function handleNewsletterSubmit(event) {
      event.preventDefault();
      event.stopPropagation(); // Prevent event bubbling

      const email = event.target.email.value;

      // Basic email validation
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        alert("Please enter a valid email address.");
        return;
      }

      // Simulate subscription process
      alert("Thank you for subscribing to our newsletter!");
      event.target.reset();
    }

    // Fix footer click issues and add proper event handling
    document.addEventListener("DOMContentLoaded", function () {
      const footer = document.querySelector("footer");
      const footerLinks = footer.querySelectorAll("a");
      const footerButtons = footer.querySelectorAll("button");
      const footerInputs = footer.querySelectorAll("input");

      // Prevent footer background clicks from navigating
      footer.addEventListener("click", function (event) {
        // Only allow clicks on specific interactive elements
        const clickableElements = ["A", "BUTTON", "INPUT"];
        const isClickableElement = clickableElements.includes(
          event.target.tagName
        );
        const isInsideClickableElement =
          event.target.closest("a, button, input");

        if (!isClickableElement && !isInsideClickableElement) {
          event.preventDefault();
          event.stopPropagation();
          return false;
        }
      });

      // Ensure all links handle clicks properly
      footerLinks.forEach((link) => {
        link.addEventListener("click", function (event) {
          event.stopPropagation();

          // Prevent navigation for placeholder links
          if (
            this.href.includes("#") ||
            this.href === window.location.href + "#"
          ) {
            event.preventDefault();
            console.log("Link clicked:", this.textContent.trim());
            return false;
          }
        });

        // Add keyboard navigation
        link.addEventListener("keydown", function (event) {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            event.stopPropagation();
            this.click();
          }
        });
      });

      // Handle button clicks properly
      footerButtons.forEach((button) => {
        button.addEventListener("click", function (event) {
          event.stopPropagation();
        });
      });

      // Handle input interactions
      footerInputs.forEach((input) => {
        input.addEventListener("click", function (event) {
          event.stopPropagation();
        });

        input.addEventListener("focus", function (event) {
          event.stopPropagation();
        });
      });

      // Remove any existing event listeners that might cause unwanted navigation
      document.removeEventListener("click", unwantedClickHandler);

      // Add CSS pointer-events control
      const style = document.createElement("style");
      style.textContent = `
                footer {
                    pointer-events: auto;
                }
                footer * {
                    pointer-events: auto;
                }
                footer .absolute {
                    pointer-events: none !important;
                }
            `;
      document.head.appendChild(style);
    });

    // Dummy function to prevent errors if it was referenced elsewhere
    function unwantedClickHandler() {
      // This function is intentionally empty
    }
  </script>

