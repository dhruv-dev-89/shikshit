            "Transparent process",
          ],
        },
      ];

      // Generate steps dynamically
      function generateSteps() {
        const container = document.getElementById("steps-container");

        steps.forEach((step, index) => {
          const stepElement = document.createElement("div");
          stepElement.className = `step-card glass-card rounded-2xl sm:rounded-3xl p-4 sm:p-6 hover:bg-white/20 transition-all duration-500 slide-in-stagger min-h-[350px] sm:min-h-[380px] md:min-h-[400px]`;
          stepElement.style.animationDelay = `${0.8 + index * 0.1}s`;
          stepElement.style.setProperty("--gradient-from", step.gradient.from);
          stepElement.style.setProperty("--gradient-to", step.gradient.to);

          stepElement.innerHTML = `
                    <div class="relative h-full flex flex-col">
                        <!-- Step Number -->
                        <div class="step-number w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 rounded-xl sm:rounded-2xl flex items-center justify-center text-white font-bold text-lg sm:text-xl mb-4 sm:mb-6 mx-auto shadow-2xl flex-shrink-0">
                            ${step.number}
                        </div>
                        
                        <!-- Icon -->
                        <div class="text-2xl sm:text-3xl md:text-4xl mb-3 sm:mb-4 text-center flex-shrink-0">${
                          step.icon
                        }</div>
                        
                        <!-- Content -->
                        <div class="flex-grow flex flex-col">
                            <h3 class="text-lg sm:text-xl font-bold text-white mb-2 sm:mb-3 text-center leading-tight">${
                              step.title
                            }</h3>
                            <p class="text-gray-300 text-xs sm:text-sm mb-4 sm:mb-6 text-center leading-relaxed flex-grow">${
                              step.description
                            }</p>
                            
                            <!-- Features -->
                            <div class="space-y-1 sm:space-y-2 mt-auto">
                                ${step.features
                                  .map(
                                    (feature) => `
                                    <div class="feature-item flex items-center p-1.5 sm:p-2 rounded-lg">
                                        <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-emerald-400 mr-2 sm:mr-3 flex-shrink-0"></div>
                                        <span class="text-gray-300 text-xs sm:text-sm leading-tight">${feature}</span>
                                    </div>
                                `
                                  )
                                  .join("")}
                            </div>
                        </div>
                    </div>
                `;

          container.appendChild(stepElement);
        });
      }

      // Initialize animations
      function initializeAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.style.animationPlayState = "running";
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: "50px",
          }
        );

        document.querySelectorAll(".slide-in-stagger").forEach((el) => {
          observer.observe(el);
        });
      }

      // Initialize everything when DOM is loaded
      document.addEventListener("DOMContentLoaded", () => {
        generateSteps();
        setTimeout(initializeAnimations, 100);
      });

      // Add interactive hover effects (only for larger screens)
      if (window.innerWidth > 768) {
        document.addEventListener("mousemove", (e) => {
          const cards = document.querySelectorAll(".step-card");
          cards.forEach((card) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            if (x >= 0 && x <= rect.width && y >= 0 && y <= rect.height) {
              const centerX = rect.width / 2;
              const centerY = rect.height / 2;
              const rotateX = (y - centerY) / 15;
              const rotateY = (centerX - x) / 15;

              card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-8px) scale(1.02)`;
            } else {
              card.style.transform = "";
            }
          });
        });
      }

      // Handle window resize for responsive behavior
      window.addEventListener("resize", () => {
        if (window.innerWidth <= 768) {
          document.querySelectorAll(".step-card").forEach((card) => {
            card.style.transform = "";
          });
        }
      });
    </script>

