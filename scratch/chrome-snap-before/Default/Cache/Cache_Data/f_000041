        .category-shape {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border-radius: 24px;
            padding: 48px 36px;
            position: relative;
            overflow: hidden;
            box-shadow:
                0 15px 40px rgba(0, 0, 0, 0.12),
